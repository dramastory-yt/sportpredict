# et restent dans le localStorage du navigateur. Ce fichier sert de référence pour une future version serveur.

# Obligatoire — https://the-odds-api.com (offre gratuite : 500 crédits/mois)
ODDS_API_KEY=

# Facultatif — https://console.anthropic.com (analyse qualitative des actualités)
ANTHROPIC_API_KEY=
